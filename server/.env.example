# 服务端口（默认 3000，被占用时可修改为 4000、8080 等）
PORT=3000

# JWT 签名密钥：正式部署请改为固定强随机字符串（留空则每次启动随机生成，重启会令旧 token 失效）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# token 有效期（秒），默认 7 天 = 604800
JWT_EXPIRES_IN=604800

# SQLite 数据文件路径（默认 server/data/flower.db）
# DB_FILE=./data/flower.db

# 前端静态资源目录（默认 ../web）
# WEB_DIR=../web

# 后端统一静态资源目录（默认 server/static，图片对外以 /static 前缀访问）
# STATIC_DIR=./static
