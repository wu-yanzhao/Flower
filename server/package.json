{
  "name": "flower-shop-server",
  "version": "1.0.0",
  "description": "鲜花订购与管理系统 · 后端服务（Express + SQLite）",
  "main": "src/app.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/app.js",
    "dev": "node --no-warnings --watch src/app.js",
    "reset": "node --no-warnings scripts/reset.js",
    "seed": "node --no-warnings scripts/seed.js",
    "test:api": "node --no-warnings scripts/smoke-test.js",
    "test:admin": "node --no-warnings scripts/admin-test.js",
    "test:upload": "node --no-warnings scripts/upload-test.js",
    "test:extended": "node --no-warnings scripts/extended-test.js",
    "test:unit": "node --no-warnings --test test/jwt.test.js test/password.test.js test/utils.test.js",
    "test": "npm run test:api && npm run reset && npm run test:admin && npm run reset && npm run test:extended && npm run test:unit"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "keywords": [
    "鲜花",
    "电商",
    "毕业设计",
    "Express",
    "SQLite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "author": "",
  "type": "commonjs"
}
